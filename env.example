# Copy to .env.local for local development. GitHub Actions reads the same names from
# repository secrets (Firebase) and repository variables (everything else).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave empty for local development; set for production builds.
VITE_BASE_PATH=/
VITE_SITE_URL=
VITE_CONTACT_EMAIL=

# Google AdSense (ca-pub-… publisher id and two display ad unit ids).
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_REST=
VITE_ADSENSE_SLOT_CONTENT=

# Coach voice clip generation (scripts/generate-voices.ts, run locally or in the
# generate-voices workflow). Free Google AI Studio API key; never commit the value.
# Content sent on the free tier may be used by Google to improve its products —
# only workout coaching lines from this repo are sent.
GEMINI_API_KEY=
