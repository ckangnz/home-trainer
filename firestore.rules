rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validRoutineBody(routine) {
      return routine.name is string
        && routine.name.size() > 0
        && routine.name.size() <= 60
        && (!('description' in routine) || (routine.description is string && routine.description.size() <= 280))
        && routine.defaults is map
        && routine.items is list
        && routine.items.size() <= 60;
    }

    match /users/{userId}/routines/{routineId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validRoutineBody(request.resource.data);
    }

    match /users/{userId}/completions/{completionId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.durationMs is number;
    }

    match /shares/{code} {
      allow get: if code.matches('^[0-9A-HJKMNP-TV-Z]{8}$');
      allow list: if false;
      allow create: if isSignedIn()
        && code.matches('^[0-9A-HJKMNP-TV-Z]{8}$')
        && request.resource.data.code == code
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.schemaVersion is int
        && request.resource.data.createdAt is string
        && request.resource.data.keys().hasOnly(['code', 'ownerId', 'schemaVersion', 'createdAt', 'routine'])
        && validRoutineBody(request.resource.data.routine);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
