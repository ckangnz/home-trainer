rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFriendOf(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid));
    }

    function requestExists(from, to) {
      return exists(/databases/$(database)/documents/friendRequests/$(from + '_' + to));
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 80;
    }

    function validPhoto(data, field) {
      return !(field in data) || (data[field] is string && data[field].size() <= 500);
    }

    function validRoutineBody(routine) {
      return routine.name is string
        && routine.name.size() > 0
        && routine.name.size() <= 60
        && (!('description' in routine) || (routine.description is string && routine.description.size() <= 280))
        && routine.defaults is map
        && routine.items is list
        && routine.items.size() <= 60;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isFriendOf(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'friendCode', 'updatedAt'])
        && validName(request.resource.data.displayName)
        && validPhoto(request.resource.data, 'photoURL')
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.matches('^[0-9A-HJKMNP-TV-Z]{8}$');
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/private/settings {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['settings', 'updatedAt'])
        && request.resource.data.settings is map
        && request.resource.data.settings.keys().hasOnly(['voice', 'beeps', 'vibration', 'keepAwake', 'trainer', 'skin', 'weightKg', 'heightCm', 'language'])
        && request.resource.data.updatedAt is number;
    }

    match /users/{userId}/private/progress {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['totalWorkouts', 'totalMs', 'lastCompletedAt', 'longestStreak', 'streakStart', 'streakEnd'])
        && request.resource.data.totalWorkouts is int
        && request.resource.data.longestStreak is int;
    }

    match /users/{userId}/weights/{day} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date', 'kg', 'updatedAt'])
        && request.resource.data.date == day
        && request.resource.data.kg is number
        && request.resource.data.kg >= 20
        && request.resource.data.kg <= 400
        && request.resource.data.updatedAt is string;
    }

    function sharesFood(userId) {
      let prefs = /databases/$(database)/documents/users/$(userId)/food/prefs;
      return isFriendOf(userId) && exists(prefs) && get(prefs).data.shareWithFriends == true;
    }

    match /users/{userId}/food/prefs {
      allow read: if isOwner(userId) || isFriendOf(userId);
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['activePlanId', 'shareWithFriends', 'updatedAt'])
        && (request.resource.data.activePlanId == null || request.resource.data.activePlanId is string)
        && request.resource.data.shareWithFriends is bool
        && request.resource.data.updatedAt is string;
    }

    match /users/{userId}/mealPlans/{planId} {
      allow read: if isOwner(userId) || isFriendOf(userId);
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.meals is map
        && request.resource.data.meals.keys().hasOnly(['breakfast', 'lunch', 'dinner', 'snacks'])
        && request.resource.data.updatedAt is string;
    }

    match /users/{userId}/foodLogs/{day} {
      allow read: if isOwner(userId) || sharesFood(userId);
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date', 'entries', 'cheat', 'updatedAt'])
        && (!('cheat' in request.resource.data) || request.resource.data.cheat is bool)
        && request.resource.data.date == day
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 40
        && request.resource.data.updatedAt is string;
    }

    match /users/{userId}/customFoods/{foodId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'serving', 'kcal', 'protein', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.serving is string
        && request.resource.data.serving.size() <= 60
        && request.resource.data.kcal is number
        && request.resource.data.kcal >= 0
        && request.resource.data.kcal < 10000
        && request.resource.data.protein is number
        && request.resource.data.protein >= 0
        && request.resource.data.createdAt is string;
    }

    match /users/{userId}/awards/{awardId} {
      allow read: if isOwner(userId) || isFriendOf(userId);
      allow create: if isOwner(userId)
        && awardId.matches('^[a-z0-9-]{3,40}$')
        && request.resource.data.keys().hasOnly(['earnedAt'])
        && request.resource.data.earnedAt is string;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/friends/{friendId} {
      allow read: if isOwner(userId);
      allow create: if isSignedIn()
        && userId != friendId
        && request.resource.data.uid == friendId
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'since'])
        && validName(request.resource.data.displayName)
        && validPhoto(request.resource.data, 'photoURL')
        && request.resource.data.since is string
        && ((request.auth.uid == userId && requestExists(friendId, userId))
          || (request.auth.uid == friendId && requestExists(userId, friendId)));
      allow update: if false;
      allow delete: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == friendId);
    }

    match /friendCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn()
        && code.matches('^[0-9A-HJKMNP-TV-Z]{8}$')
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL'])
        && validName(request.resource.data.displayName)
        && validPhoto(request.resource.data, 'photoURL');
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{id} {
      allow read: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.to))
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'fromPhoto', 'to', 'toName', 'toPhoto', 'createdAt'])
        && validName(request.resource.data.fromName)
        && validName(request.resource.data.toName)
        && validPhoto(request.resource.data, 'fromPhoto')
        && validPhoto(request.resource.data, 'toPhoto')
        && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /users/{userId}/routines/{routineId} {
      allow read: if isOwner(userId) || isFriendOf(userId);
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validRoutineBody(request.resource.data);
    }

    match /users/{userId}/completions/{completionId} {
      allow read: if isOwner(userId) || isFriendOf(userId);
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.durationMs is number;
    }

    match /shares/{code} {
      allow get: if code.matches('^[0-9A-HJKMNP-TV-Z]{8}$');
      allow list: if false;
      allow create: if isSignedIn()
        && code.matches('^[0-9A-HJKMNP-TV-Z]{8}$')
        && request.resource.data.code == code
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.schemaVersion is int
        && request.resource.data.createdAt is string
        && request.resource.data.keys().hasOnly(['code', 'ownerId', 'schemaVersion', 'createdAt', 'routine'])
        && validRoutineBody(request.resource.data.routine);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
